{
  "name": "comparatif-menopause",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "test": "node --test \"tests/*.test.ts\"",
    "verifier": "node scripts/verifier-conformite.mjs",
    "verifier:strict": "node scripts/verifier-conformite.mjs --strict",
    "verifier:html": "node scripts/verifier-html.mjs",
    "build": "npm run test && npm run verifier && next build && npm run verifier:html",
    "build:prod": "npm run test && npm run verifier:strict && next build && npm run verifier:html",
    "apercu": "node scripts/apercu.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
